# Only vendor/mage-os/ — for TARGET=mageos rebuilds

# Override hardcoded vendor ignore — must negate parent first for children to work
!vendor/
!vendor/mage-os/

# Re-ignore everything else inside vendor
vendor/*
!vendor/mage-os/

# Exclude non-essential mage-os packages
vendor/mage-os/language-*
vendor/mage-os/sample-data-media
vendor/mage-os/composer*
vendor/mage-os/inventory-composer-installer
vendor/mage-os/magento-allure-phpunit
vendor/mage-os/magento-coding-standard
vendor/mage-os/magento-composer-installer
vendor/mage-os/magento2-functional-testing-framework
vendor/mage-os/php-compatibility-fork
vendor/mage-os/zend-*
vendor/mage-os/magento-zf-db

# Exclude directories
gitnexus-magento/
.claude/
patches/
LokiCheckout*

# Exclude files
*.md
.env*

# Exclude tests everywhere
**/Test/
**/Tests/
**/test/
**/tests/

# Exclude sample data modules
**/*-sample-data/
**/module-*-sample-data

# Module boilerplate — adds noise, no graph value
vendor/**/registration.php
vendor/**/composer.json
vendor/**/LICENSE*
vendor/**/license*
vendor/**/COPYING*
vendor/**/CHANGELOG*

# Minified JS — known tree-sitter Napi crash risk
**/*.min.js
**/*-min.js
**/*.bundle.js

# Vendored 3rd-party JS libs bundled by Magento (not your code)
vendor/mage-os/magento2-base/lib/web/jquery*
vendor/mage-os/magento2-base/lib/web/jquery/
vendor/mage-os/magento2-base/lib/web/knockoutjs/
vendor/mage-os/magento2-base/lib/web/prototype/
vendor/mage-os/magento2-base/lib/web/fotorama/
vendor/mage-os/magento2-base/lib/web/chartjs/
vendor/mage-os/magento2-base/lib/web/less/
vendor/mage-os/magento2-base/lib/web/hugerte/
vendor/mage-os/magento2-base/lib/web/moment*.js
vendor/mage-os/module-swagger/view/frontend/web/swagger-ui/
