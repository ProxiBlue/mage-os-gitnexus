# Path to your Mage-OS project root (the dir containing composer.json + vendor/).
# Used as primary code source for the bundled mageos / hyva / deps indexes
# that the container ships pre-built.
MAGEOS_PROJECT_PATH=/path/to/your/mageos

# Optional: override host port if 4747 is taken (e.g. DDEV already forwards it).
# GITNEXUS_UI_PORT=4748

# Optional: disable XML augmenter for mounted projects (default = on if mount
# looks like a full Magento project).
# AUGMENT=0
